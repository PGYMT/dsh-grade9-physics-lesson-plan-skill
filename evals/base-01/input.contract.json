    {
      "dimension": "物理观念",
      "text": "知道电流由电荷的定向移动形成，方向按正电荷定向移动的方向规定"
    },
    {
      "dimension": "科学思维",
      "text": "由去掉电池、剪断导线的现象推理持续电流的条件，并抽象出回路模型"
    },
    {
      "dimension": "科学探究",
      "text": "针对通电前后自由电子的不同提出问题，观察动画获取证据并作出解释"
    },
    {
      "dimension": "科学态度与责任",
      "text": "结合短路引发火灾的事例增强安全用电意识，坚持不把导线直接接在电池两端"
    }
  ],
