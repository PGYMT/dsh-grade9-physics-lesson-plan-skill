{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill.local/g9-physics/deck.schema.json",
  "title": "课件逐页清单（deck.json）",
  "description": "一个课件（.enbx）的逐页清单：页号、页标题、知识点、动画与出现顺序、该页截图。用于把「教案说的第几页」和「课件里实际是哪一页」对齐。截图路径相对 deck.json 所在目录。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "file",
    "pages"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "节号，如 15.2；必须与课程契约的 section 一致"
    },
    "file": {
      "type": "string",
      "minLength": 1,
      "description": "课件文件名（.enbx），只写文件名不写路径"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "no",
          "title",
          "knowledge",
          "animations",
          "reveal_order",
          "shot"
        ],
        "properties": {
          "no": {
            "type": "integer",
            "minimum": 1,
            "description": "页号，从 1 开始连续"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "页标题（与课件上的标题一致）"
          },
          "knowledge": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "本页承载的知识点"
          },
          "animations": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30,
            "description": "本页点击出现次数（动画数）"
          },
          "reveal_order": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "点击后依次出现的元素，条数必须等于 animations"
          },
          "shot": {
            "type": "string",
            "minLength": 1,
            "description": "本页截图路径，相对 deck.json 所在目录，如 shots/p07.png"
          }
        }
      }
    }
  }
}
